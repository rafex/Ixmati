# containers/base/Containerfile — builder compartido con cargo-chef
#
# Compila los 5 binarios UNA vez. Los Containerfiles de servicio
# copian desde localhost/ixmati-builder:local.

FROM docker.io/library/rust:1.97-slim-bookworm AS chef
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release --bin ixmati-api \
                     --bin ixmati-writer \
                     --bin ixmati-projector \
                     --bin ixmati-supervisor \
                     --bin ixmati-reconciler

FROM scratch AS export
COPY --from=builder /app/target/release/ixmati-api /out/ixmati-api
COPY --from=builder /app/target/release/ixmati-writer /out/ixmati-writer
COPY --from=builder /app/target/release/ixmati-projector /out/ixmati-projector
COPY --from=builder /app/target/release/ixmati-supervisor /out/ixmati-supervisor
COPY --from=builder /app/target/release/ixmati-reconciler /out/ixmati-reconciler
