# containers/writer/Containerfile — ixmati-writer (un writer por store)
FROM localhost/ixmati-builder:local AS build
FROM docker.io/library/debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/ixmati-writer /usr/local/bin/ixmati-writer

USER 1000:1000
ENTRYPOINT ["ixmati-writer"]
