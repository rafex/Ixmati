[Unit]
Description=Ixmati API (REST + gRPC)
After=network.target mosquitto.service
Requires=mosquitto.service
Documentation=https://github.com/rafex/Ixmati

[Service]
Type=simple
User=ixmati
Group=ixmati
ExecStart=/usr/local/bin/ixmati-api
Environment=MQTT_BROKER=tcp://localhost:1883
Environment=API_HOST=0.0.0.0
Environment=API_PORT=30000
Environment=IXMATI_API_KEYS=ix-default-key
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
