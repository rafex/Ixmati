[Unit]
Description=Ixmati API (REST + gRPC)
After=network.target mosquitto.service ixmati-cache-server.service
Requires=mosquitto.service ixmati-cache-server.service
Documentation=https://github.com/rafex/Ixmati

[Service]
Type=simple
User=ixmati
Group=ixmati
ExecStart=/usr/local/bin/ixmati-api
Environment=MQTT_BROKER=tcp://localhost:1883
Environment=API_HOST=0.0.0.0
Environment=API_PORT=30000
Environment=GRPC_HOST=0.0.0.0
Environment=GRPC_PORT=30100
# Configure this file before exposing the API. The installer creates it only
# when IXMATI_API_KEYS is explicitly supplied and preserves it on reinstall.
# With no key the API fails closed (protected requests are rejected) instead
# of shipping a shared credential.
EnvironmentFile=-/etc/ixmati/ixmati.env
Environment=CACHE_READ_MODE=socket
Environment=CACHE_SOCKET_PATH=/var/run/ixmati/cache.sock
Environment=SQLITE_PATH=/var/lib/ixmati/stores/default.db
# Rate-limiter y backpressure (ver DEC-0054/TASK-VAL-0013/TASK-VAL-0020):
# los defaults del binario ya reflejan la capacidad real medida del writer
# (~30-40 commits/s sostenidos a SQLite) — MAX_WRITES_PER_WINDOW=10/s,
# THROTTLE_WINDOW_SECS=1, OUTBOX_BACKPRESSURE_THRESHOLD=500. Ajustar acá
# solo si el hardware del store es distinto al medido o si se quiere
# tolerar más ráfaga a costa de backlog. No se fijan explícitos acá a
# propósito, para no duplicar el default y arriesgar que quede
# desincronizado del binario — descomentar y ajustar si hace falta:
#Environment=MAX_WRITES_PER_WINDOW=10
#Environment=THROTTLE_WINDOW_SECS=1
#Environment=OUTBOX_BACKPRESSURE_THRESHOLD=500
# Límites de entrada y streams (los defaults seguros viven en el binario;
# ajustar sólo para un contrato de payload y concurrencia conocidos):
#Environment=MAX_REQUEST_BODY_BYTES=1048576
#Environment=GRPC_MAX_MESSAGE_BYTES=1048576
#Environment=GRPC_MAX_CONCURRENT_STREAMS=256
#Environment=EVENT_STREAM_BUFFER_CAPACITY=128
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
