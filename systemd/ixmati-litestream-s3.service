[Unit]
Description=Ixmati Litestream S3 replica
After=network-online.target ixmati-litestream-file.service
Wants=network-online.target
RequiresMountsFor=/var/lib/ixmati/stores
ConditionPathExists=/usr/local/lib/ixmati/litestream
ConditionPathExists=/etc/ixmati/litestream-s3.yml
Documentation=https://github.com/rafex/Ixmati

[Service]
Type=simple
User=ixmati
Group=ixmati
EnvironmentFile=/etc/ixmati/litestream.env
ExecStart=/usr/local/lib/ixmati/litestream replicate -config /etc/ixmati/litestream-s3.yml
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ixmati/stores /var/lib/ixmati/litestream-meta/s3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
