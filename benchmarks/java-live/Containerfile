FROM docker.io/library/maven:3.9.12-eclipse-temurin-21 AS build
WORKDIR /build
COPY benchmarks/java-live/pom.xml .
COPY benchmarks/java-live/src ./src
COPY proto ./proto
RUN mvn -q -Dproto.source.root=/build/proto -DskipTests package

FROM docker.io/library/eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/target/java-live-client-0.1.0.jar /app/java-live-client.jar
COPY benchmarks/java-live/entrypoint.sh /app/entrypoint.sh
ENTRYPOINT ["sh", "/app/entrypoint.sh"]
